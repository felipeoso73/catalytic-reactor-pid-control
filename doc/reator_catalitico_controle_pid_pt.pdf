\section{Explicação do Código em MATLAB / GNU Octave por Seções}

O script completo é compatível sem alterações tanto com \textbf{MATLAB} quanto com \textbf{GNU Octave}, empregando integração numérica passo a passo (Runge-Kutta de quarta ordem, RK4) para acoplar o controlador discreto à dinâmica contínua do reator.

\subsection{Seção 1: Definição de Parâmetros e Verificação do Regime Permanente}
Neste primeiro bloco declaram-se as constantes físicas do reator bifásico e verifica-se analiticamente que a temperatura de ajuste $T_s = 415{,}0\text{ K}$ produz uma eficiência de conversão de exatamente $73{,}0\%$, calculando também a temperatura nominal requerida na camisa térmica ($T_{c,s}$).

\begin{lstlisting}
clear; clc; close all;

% 1. Parametros fisico-quimicos do reator catalitico bifasico (P = 25 bar cte.)
V     = 1.20;       % Volume efetivo fase liquida-suspensao [m^3]
F     = 0.040;      % Vazao volumetrica de alimentacao [m^3/min]
tau   = V / F;      % Tempo espacial nominal = 30.0 min
CA0_s = 2.50;       % Concentracao nominal de entrada do residuo [kmol/m^3]
T0_s  = 365.0;      % Temperatura nominal de alimentacao [K]
Ts    = 415.0;      % Temperatura nominal do reator (Setpoint) [K]

k0    = 1.85e6;     % Fator pre-exponencial efetivo (saturacao H2) [1/min]
Ea_R  = 6450.0;     % Energia de ativacao / R [K]
dHr   = -68000.0;   % Entalpia de reacao exotermica [kJ/kmol]
rhoCp = 3450.0;     % Capacidade calorifica volumetrica [kJ/(m^3*K)]
UA    = 145.0;      % Coeficiente global de transferencia de calor [kJ/(min*K)]

% Verificacao da conversao nominal (73.0%) e calculo de Tc estacionaria
ks    = k0 * exp(-Ea_R / Ts);
XA_s  = (ks * tau) / (1 + ks * tau);     % Resultado: 0.7300 (73.0%)
CA_s  = CA0_s * (1 - XA_s);              % Resultado: 0.6750 kmol/m^3
Qgen  = (-dHr / rhoCp) * ks * CA_s;
Tcs   = Ts - (V * rhoCp / UA) * ((F/V)*(T0_s - Ts) + Qgen); % 380.6 K
fprintf('Conversao nominal verificada: %.2f %% | Tc nominal: %.2f K\n', XA_s*100, Tcs);
\end{lstlisting}

\subsection{Seção 2: Horizonte Temporal, Perturbações e Sintonia PID}
Define-se o horizonte de simulação de $140\text{ min}$ com passo $\Delta t = 0{,}2\text{ min}$, constroem-se os perfis de perturbação de carga ($+20\%$ em $C_{A0}$ em $t = 20\text{ min}$ e $-10\text{ K}$ em $T_0$ em $t = 80\text{ min}$) e fixam-se os ganhos do controlador PID.

\begin{lstlisting}
% 2. Configuracao temporal, perturbacoes e sintonia PID
dt = 0.2;
t  = 0:dt:140;
N  = length(t);

% Perfis de perturbacao na corrente residual
CA0 = CA0_s * ones(1, N);
CA0(t >= 20) = 1.20 * CA0_s;    % Degrau +20% na concentracao de residuo

T0 = T0_s * ones(1, N);
T0(t >= 80) = T0_s - 10.0;      % Queda de -10 K na temperatura de entrada

% Parametros do controlador PID (realimentacao RTD Pt100)
Tsp   = Ts;
Kc    = 3.20;
tauI  = 8.50;
tauD  = 1.20;
Tc_min = 320.0; Tc_max = 430.0; % Saturacao fisica da camisa termica [K]
\end{lstlisting}

\subsection{Seção 3: Simulação Dinâmica (Malha Aberta vs. Malha Fechada RK4)}
As equações diferenciais acopladas do reator são definidas como função anônima e integradas via Runge-Kutta de quarta ordem tanto para o caso sem controle ($T_c = T_{c,s}$ constante) quanto para o caso controlado com PID e proteção \textit{anti-windup}.

\begin{lstlisting}
% 3. Dinamica do reator (EDOs acopladas) e integracao RK4
reactor_ode = @(CA, T, CA_in, T_in, Tc_val) [ ...
    (F/V)*(CA_in - CA) - k0*exp(-Ea_R/T)*CA; ...
    (F/V)*(T_in - T) + (-dHr/rhoCp)*k0*exp(-Ea_R/T)*CA - (UA/(V*rhoCp))*(T - Tc_val) ...
];

% Inicializacao dos vetores de estado
CA_ol = zeros(1,N); T_ol = zeros(1,N); CA_ol(1) = CA_s; T_ol(1) = Ts;
CA_cl = zeros(1,N); T_cl = zeros(1,N); CA_cl(1) = CA_s; T_cl(1) = Ts;
Tc_cl = Tcs * ones(1,N);

int_err = 0; prev_err = 0;

for k = 1:N-1
    % --- A) Malha aberta (Tc fixa em Tcs) ---
    x_ol = [CA_ol(k); T_ol(k)];
    k1 = reactor_ode(x_ol(1), x_ol(2), CA0(k), T0(k), Tcs);
    k2 = reactor_ode(x_ol(1)+0.5*dt*k1(1), x_ol(2)+0.5*dt*k1(2), CA0(k), T0(k), Tcs);
    k3 = reactor_ode(x_ol(1)+0.5*dt*k2(1), x_ol(2)+0.5*dt*k2(2), CA0(k), T0(k), Tcs);
    k4 = reactor_ode(x_ol(1)+dt*k3(1), x_ol(2)+dt*k3(2), CA0(k), T0(k), Tcs);
    x_next_ol = x_ol + (dt/6)*(k1 + 2*k2 + 2*k3 + k4);
    CA_ol(k+1) = x_next_ol(1); T_ol(k+1) = x_next_ol(2);

    % --- B) Malha fechada (Controle PID com anti-windup) ---
    err = Tsp - T_cl(k);
    der_err = (err - prev_err) / dt;
    Tc_unsat = Tcs + Kc * (err + (1/tauI)*(int_err + err*dt) + tauD*der_err);
    Tc_sat = min(max(Tc_unsat, Tc_min), Tc_max);
    if Tc_unsat == Tc_sat
        int_err = int_err + err * dt; % Acumula integral apenas sem saturacao
    end
    Tc_cl(k) = Tc_sat; prev_err = err;

    x_cl = [CA_cl(k); T_cl(k)];
    k1 = reactor_ode(x_cl(1), x_cl(2), CA0(k), T0(k), Tc_sat);
    k2 = reactor_ode(x_cl(1)+0.5*dt*k1(1), x_cl(2)+0.5*dt*k1(2), CA0(k), T0(k), Tc_sat);
    k3 = reactor_ode(x_cl(1)+0.5*dt*k2(1), x_cl(2)+0.5*dt*k2(2), CA0(k), T0(k), Tc_sat);
    k4 = reactor_ode(x_cl(1)+dt*k3(1), x_cl(2)+dt*k3(2), CA0(k), T0(k), Tc_sat);
    x_next_cl = x_cl + (dt/6)*(k1 + 2*k2 + 2*k3 + k4);
    CA_cl(k+1) = x_next_cl(1); T_cl(k+1) = x_next_cl(2);
end
Tc_cl(N) = Tc_cl(N-1);
\end{lstlisting}

\subsection{Seção 4: Cálculo da Eficiência de Conversão e Exportação dos Gráficos}
Por fim, calcula-se a eficiência instantânea de conversão $X_A(t) = 100 \times (C_{A0}(t) - C_A(t))/C_{A0}(t)$ e geram-se as figuras prontas para exportação em alta resolução ao repositório no GitHub.

\begin{lstlisting}
% 4. Calculo da conversao instantanea e geracao dos graficos
XA_ol = 100 * (CA0 - CA_ol) ./ CA0;
XA_cl = 100 * (CA0 - CA_cl) ./ CA0;

figure('Color','w','Position',[100 100 850 620]);
subplot(2,1,1);
plot(t, T_ol, '--', 'Color', [0.71 0.33 0.04], 'LineWidth', 1.8); hold on;
plot(t, T_cl, '-',  'Color', [0.12 0.23 0.37], 'LineWidth', 2.0);
yline(Tsp, ':k', 'LineWidth', 1.2);
ylabel('Temperatura T [K]');
title('Controle Termico PID em Reator Catalitico Bifasico (P = 25 bar)');
legend('Malha aberta', 'Malha fechada (PID)', 'Setpoint (415 K)', 'Location', 'northeast');
grid on;

subplot(2,1,2);
plot(t, XA_ol, '--', 'Color', [0.71 0.33 0.04], 'LineWidth', 1.8); hold on;
plot(t, XA_cl, '-',  'Color', [0.06 0.46 0.43], 'LineWidth', 2.0);
yline(73.0, ':k', 'LineWidth', 1.2);
xlabel('Tempo [min]'); ylabel('Conversao X_A [%]');
legend('Conversao malha aberta', 'Conversao com PID', 'Nominal (73.0%)', 'Location', 'northeast');
grid on;
\end{lstlisting}

